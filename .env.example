# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Neon console -> Connection Details).
# Use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the app (used by the server and the auth client).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Paystack: Dashboard -> Settings -> API Keys & Webhooks. An sk_test_ key, unless PAYSTACK_MODE is
# "live": then it must be an sk_live_ key, and the app takes it only in a production build on an
# https BETTER_AUTH_URL. Also set the webhook URL there to <your public URL>/api/webhooks/paystack.
PAYSTACK_SECRET_KEY=""
# Leave empty (test mode) until Paystack has verified the business; then "live" on production only.
PAYSTACK_MODE=""

# Vercel Blob, for product image uploads in the admin: Vercel -> Storage -> Blob -> your store.
# Set automatically when the store is connected to the Vercel project. Without it, uploads are off.
BLOB_READ_WRITE_TOKEN=""

# Resend (email): resend.com -> API Keys. EMAIL_FROM must be an address on a domain verified in
# Resend, e.g. "Sydo <orders@yourdomain.com>". Without a key, development prints emails to the
# terminal instead of sending them (so you can open the links); production refuses to send.
RESEND_API_KEY=""
EMAIL_FROM=""

# Bearer token the scheduler sends to GET /api/cron/expire-orders: the GitHub Actions workflow in
# .github/workflows/expire-orders.yml, every 15 minutes (store the same value as a GitHub secret).
CRON_SECRET=""

# Tests (npm run test) — put this in .env.test.local, not .env.local.
# An EMPTY Neon database whose name ends in _test (not a branch of the store data).
# Tests refuse to run against any other database, and never read DATABASE_URL.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/sydo_test?sslmode=require"
