# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Neon console -> Connection Details).
# Use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret with: npx auth secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the app (used by the server and the auth client).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
